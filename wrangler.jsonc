{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "forca-brasileira",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/health"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "PlayerSession"
      },
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "DIRECTORY",
        "class_name": "GameDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PlayerSession",
        "GameRoom",
        "GameDirectory"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
