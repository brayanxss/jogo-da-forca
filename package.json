{
  "name": "forca-brasileira",
  "version": "1.0.0",
  "private": true,
  "description": "Jogo da forca em português com partidas online em tempo real.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build": "wrangler deploy --dry-run",
    "dev:cloudflare": "wrangler dev",
    "migrate:cloudflare:local": "wrangler d1 migrations apply forca-brasileira-ranking --local",
    "migrate:cloudflare:remote": "wrangler d1 migrations apply forca-brasileira-ranking --remote",
    "deploy:cloudflare": "npm run migrate:cloudflare:remote && wrangler deploy",
    "test:cloudflare": "vitest run --config cloudflare/vitest.config.mjs --max-workers=1 --no-isolate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.0"
  }
}
